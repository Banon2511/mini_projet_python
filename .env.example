# MiniSec Scanner - Configuration Environnement
# Copiez ce fichier en .env et adaptez les valeurs

# Configuration Flask
FLASK_ENV=development
SECRET_KEY=votre-clé-secrète-ici-changez-en-production
DEBUG=True

# Configuration Base de Données
DATABASE_URL=sqlite:///scanner.db
# Pour PostgreSQL: postgresql://user:password@localhost/minisec
# Pour MySQL: mysql://user:password@localhost/minisec

# Configuration Redis (optionnel, pour le cache et rate limiting)
REDIS_URL=redis://localhost:6379/0

# Configuration YARA
YARA_RULES_FILE=rules/malware_rules.yar
YARA_TIMEOUT=30

# Configuration Scanner
MAX_SCAN_DURATION=300
MAX_FILES_PER_SCAN=10000
MAX_FILE_SIZE=52428800
DEFAULT_SCAN_RECURSIVE=True
DEFAULT_ANALYZE_CONTENT=False

# Configuration Logging
LOG_LEVEL=INFO
LOG_FILE=scanner.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Configuration Rate Limiting
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=100 per hour

# Configuration Sécurité
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Configuration Quarantaine
QUARANTINE_FOLDER=quarantine
AUTO_QUARANTINE_HIGH_RISK=True
RETENTION_DAYS=30

# Configuration Rapports
REPORTS_FOLDER=reports
MAX_REPORTS_AGE_DAYS=30

# Configuration Notifications (optionnel)
ENABLE_NOTIFICATIONS=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe
NOTIFICATION_EMAIL=admin@example.com

# Configuration Monitoring
ENABLE_METRICS=False
METRICS_PORT=9090

# Configuration Développement
TESTING=False
WTF_CSRF_ENABLED=True
